{
	"name": "hotel-pms",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"db:up": "docker compose up -d db",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx scripts/seed.ts",
		"db:seed:demo": "tsx scripts/seed-demo.ts",
		"night-audit": "tsx scripts/night-audit.ts",
		"pii:reencrypt": "tsx scripts/reencrypt-id-documents.ts",
		"ops:reset": "tsx scripts/reset-operational-data.ts",
		"ops:bootstrap": "tsx scripts/bootstrap.ts",
		"build:tools": "esbuild scripts/migrate.ts scripts/seed.ts scripts/night-audit.ts scripts/reencrypt-id-documents.ts scripts/reset-operational-data.ts scripts/seed-demo.ts scripts/bootstrap.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist-tools --out-extension:.js=.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
		"db:migrate:runtime": "tsx scripts/migrate.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "5.5.8",
		"@sveltejs/kit": "2.70.4",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "^22.0.0",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.45.4",
		"esbuild": "0.25.12",
		"postgres": "3.4.9",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"vite": "7.3.8",
		"vitest": "3.2.7",
		"zod": "4.6.7"
	}
}
