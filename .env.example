# Postgres from docker-compose (host port 5433)
DATABASE_URL=postgres://pms:pms@localhost:5433/pms
# Integration tests use a separate database
TEST_DATABASE_URL=postgres://pms:pms@localhost:5433/pms_test
# Shared secret for inbound OTA webhooks + signing outbound ARI pushes (min 32 chars)
# generate: openssl rand -hex 32
CHANNEL_WEBHOOK_SECRET=
# AES-256-GCM key for guest ID numbers: <keyId>:<base64 32 bytes>. DEV ONLY value below — never use outside local dev;
# generate a real one per environment: echo "k$(date +%Y%m):$(openssl rand -base64 32)"
PII_ENCRYPTION_KEY=dev:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Old keys kept for decryption during rotation (comma-separated <keyId>:<base64>)
PII_ENCRYPTION_PREVIOUS_KEYS=
# Only used with SEED_DEMO=true (demo seed); unset = random password printed by the seed
SEED_ADMIN_PASSWORD=
# Docker stack
HTTP_PORT=8088
# Required by docker compose (compose refuses to start without it). Generate: openssl rand -hex 24
# (hex keeps DATABASE_URL valid). Keep DATABASE_URL / TEST_DATABASE_URL above in sync with it.
POSTGRES_PASSWORD=
# true = load demo hotel "Harbor House" on boot (dev/staging only — never production). Empty/false = no demo data.
SEED_DEMO=
# Only used with SEED_DEMO=true / scripts/ops/seed.sh
SEED_STAFF_PASSWORD=
